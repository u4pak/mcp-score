
{
	Initialize "() {
// mcp-score calls the methods below through Sibelius Connect's invokePlugin
// message. Each takes explicit bar (1-indexed) and staff (0-indexed)
// numbers, keeps no state of its own and returns a Dictionary, which
// Sibelius Connect sends back as a JSON object. A method that cannot do
// what was asked returns a Dictionary with an error entry instead of
// showing a dialog, since nobody is at Sibelius to dismiss one.
if (Sibelius.ProgramVersion > 20200600)
{
	SetInterpreterOption(TreatSingleCharacterAsString);
}
AddToPluginsMenu(_PluginMenuName, 'Run');}"
	Run "() {
Sibelius.MessageBox(_msgRunByHand);}"
	_PluginMenuName "MCP Score Bridge"
	_msgRunByHand "mcp-score uses this plug-in through Sibelius Connect. There is nothing to run by hand."
	_msgNoScore "No score is open in Sibelius."
	Failure "(message) {
return CreateDictionary('error', message);}"
	CheckBar "(score, bar) {
// The reason bar (1-indexed) does not exist, or the empty string.
barCount = score.SystemStaff.BarCount;
if ((bar < 1) or (bar > barCount))
{
	return 'Measure ' & bar & ' out of range (1-' & barCount & ')';
}
return '';}"
	CheckStaff "(score, staff) {
// The reason staff (0-indexed) does not exist, or the empty string.
if ((staff < 0) or (staff >= score.StaffCount))
{
	return 'Staff ' & staff & ' out of range (0-' & (score.StaffCount - 1) & ')';
}
return '';}"
	CheckPosition "(score, bar, staff) {
problem = CheckBar(score, bar);
if (problem = '')
{
	problem = CheckStaff(score, staff);
}
return problem;}"
	StaffBar "(score, bar, staff) {
return score.NthStaff(staff + 1).NthBar(bar);}"
	CheckPassage "(score, startBar, endBar, staff) {
problem = CheckPosition(score, startBar, staff);
if (problem = '')
{
	problem = CheckBar(score, endBar);
}
return problem;}"
	BeatLength "(score, bar) {
// The length of a beat in bar: the time signature's denominator as a note.
timeSignature = score.SystemStaff.CurrentTimeSignature(bar);
return 1024 / timeSignature.Denominator;}"
	CheckOffset "(score, bar, staff, offsetNum, offsetDen) {
// The reason the point offsetNum/offsetDen beats into bar is not inside
// it, or the empty string.
if (OffsetPosition(score, bar, offsetNum, offsetDen) >= StaffBar(score, bar, staff).Length)
{
	return 'That position is past the end of measure ' & bar;
}
return '';}"
	NearPosition "(position, target) {
// Notes in tuplets sit at rounded positions, so match within 2 units.
return (((position - target) <= 2) and ((target - position) <= 2));}"
	NextPosition "(barObject, bar, staff, position) {
// Where the cursor goes after something ending at position in barObject.
if (position >= barObject.Length)
{
	return CreateDictionary('measure', bar + 1, 'staff', staff, 'position', 0);
}
return CreateDictionary('measure', bar, 'staff', staff, 'position', position);}"
	NoteRestAt "(barObject, position) {
// The voice 1 note or chord starting at position, or null.
found = null;
for each NoteRest noteRest in barObject
{
	if ((noteRest.VoiceNumber = 1) and (NearPosition(noteRest.Position, position)) and (noteRest.NoteCount > 0))
	{
		found = noteRest;
	}
}
return found;}"
	OffsetPosition "(score, bar, offsetNum, offsetDen) {
// Where the point offsetNum/offsetDen beats (in the time signature's beat
// unit) into bar falls, in 1/256ths of a quarter note, or -1, meaning
// every position, when offsetNum is negative.
if (offsetNum < 0)
{
	return -1;
}
return Round(((offsetNum * 1.0) * BeatLength(score, bar)) / offsetDen);}"
	Ping "() {
return 'pong';}"
	GetScore "() {
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
parts = CreateSparseArray();
staffNum = 1;
while (staffNum <= score.StaffCount)
{
	staff = score.NthStaff(staffNum);
	staveCount = staff.NumStavesInSameInstrument;
	if (staveCount < 1)
	{
		staveCount = 1;
	}
	lastStaffNum = staffNum + staveCount - 1;
	if (lastStaffNum > score.StaffCount)
	{
		lastStaffNum = score.StaffCount;
	}
	name = staff.FullInstrumentName;
	if (name = '')
	{
		name = staff.InstrumentName;
	}
	parts.Push(CreateDictionary('name', name, 'start_staff', staffNum - 1, 'end_staff', lastStaffNum - 1));
	staffNum = lastStaffNum + 1;
}
systemStaff = score.SystemStaff;
keySignature = systemStaff.CurrentKeySignature(1);
timeSignature = systemStaff.CurrentTimeSignature(1);
return CreateDictionary(
	'title', score.Title,
	'part_count', parts.Length,
	'parts', parts,
	'measure_count', systemStaff.BarCount,
	'key_signature', keySignature.Sharps,
	'time_signature', CreateDictionary('numerator', timeSignature.Numerator, 'denominator', timeSignature.Denominator));}"
	GoTo "(bar, staff) {
// Select one bar of one staff, so the user sees where mcp-score is and
// Sibelius commands such as barlines act there.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
score.Selection.SelectPassage(bar, bar, staff + 1, staff + 1);
Sibelius.MoveActiveViewToBar(bar);
return CreateDictionary('measure', bar, 'staff', staff);}"
	SelectRange "(startBar, endBar, topStaff, bottomStaff) {
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, startBar, topStaff);
if (problem = '')
{
	problem = CheckPosition(score, endBar, bottomStaff);
}
if (problem != '')
{
	return Failure(problem);
}
score.Selection.SelectPassage(startBar, endBar, topStaff + 1, bottomStaff + 1);
return CreateDictionary('start_measure', startBar, 'end_measure', endBar, 'start_staff', topStaff, 'end_staff', bottomStaff);}"
	GetCursorInfo "(bar, staff, position) {
// The voice 1 note, chord or rest sounding at position (1/256ths of a
// quarter note from the start of the bar), with the time signature's
// denominator so the caller can work out the beat.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
found = null;
for each NoteRest noteRest in StaffBar(score, bar, staff)
{
	if (noteRest.VoiceNumber = 1)
	{
		if ((noteRest.Position <= position) and (position < (noteRest.Position + noteRest.Duration)))
		{
			found = noteRest;
		}
	}
}
timeSignature = score.SystemStaff.CurrentTimeSignature(bar);
info = CreateDictionary('measure', bar, 'staff', staff, 'position', position, 'time_signature_denominator', timeSignature.Denominator);
if (found != null)
{
	notes = CreateSparseArray();
	for each note in found
	{
		notes.Push(CreateDictionary('pitch', note.Pitch, 'diatonic_pitch', note.DiatonicPitch, 'name', note.Name));
	}
	info['element'] = CreateDictionary('type', found.Type, 'position', found.Position, 'duration', found.Duration, 'notes', notes);
}
return info;}"
	AddNote "(bar, staff, position, pitch, duration) {
// Add a note of duration (1/256ths of a quarter note) at position and
// report where the next note would go.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
barObject = StaffBar(score, bar, staff);
if ((position + duration) > barObject.Length)
{
	return Failure('The note does not fit in what is left of measure ' & bar & '.');
}
note = barObject.AddNote(position, pitch, duration);
if (note = null)
{
	return Failure('Sibelius could not add the note to measure ' & bar & '.');
}
nextBar = bar;
nextPosition = position + duration;
if (nextPosition >= barObject.Length)
{
	nextBar = bar + 1;
	nextPosition = 0;
}
return CreateDictionary('measure', nextBar, 'staff', staff, 'position', nextPosition);}"
	AddRehearsalMark "(bar, mark) {
// An empty mark continues Sibelius's own numbering.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckBar(score, bar);
if (problem != '')
{
	return Failure(problem);
}
systemBar = score.SystemStaff.NthBar(bar);
if (mark = '')
{
	systemBar.AddRehearsalMark();
}
else
{
	systemBar.AddRehearsalMark(False, mark);
}
text = '';
for each RehearsalMark rehearsalMark in systemBar
{
	text = rehearsalMark.MarkAsText;
}
return CreateDictionary('text', text, 'measure', bar);}"
	AddChordSymbol "(bar, staff, position, text) {
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
chordSymbol = StaffBar(score, bar, staff).AddGuitarFrame(position, text);
if (chordSymbol = null)
{
	return Failure('Sibelius did not recognise the chord symbol ' & text & '.');
}
return CreateDictionary('text', text, 'measure', bar);}"
	AddDynamic "(bar, staff, position, dynamic) {
// Expression text in the Music text character style, as Sibelius writes
// dynamics typed with Ctrl/Cmd held down.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
text = StaffBar(score, bar, staff).AddText(position, '\\ctext.character.musictext\\' & dynamic, 'text.staff.expression');
if (text = null)
{
	return Failure('Sibelius could not add the dynamic ' & dynamic & '.');
}
return CreateDictionary('dynamic', dynamic, 'measure', bar);}"
	SetKeySignature "(bar, staff, fifths) {
// A major key for every staff, without the double barline Sibelius adds
// by default.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
keySignature = StaffBar(score, bar, staff).AddKeySignature(0, fifths, True, False);
if (keySignature = null)
{
	return Failure('Sibelius could not add the key signature.');
}
return CreateDictionary('fifths', fifths, 'measure', bar);}"
	SetTimeSignature "(bar, staff, numerator, denominator) {
// Rewrites the following bars, as Sibelius does by default.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
problem = StaffBar(score, bar, staff).AddTimeSignature(numerator, denominator, True, True);
if (problem != '')
{
	return Failure(problem);
}
return CreateDictionary('numerator', numerator, 'denominator', denominator, 'measure', bar);}"
	SetTempo "(bar, bpm, text) {
// Tempo text followed by a metronome mark (q is a quarter note in the
// Music text character style), which Sibelius plays back.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckBar(score, bar);
if (problem != '')
{
	return Failure(problem);
}
marking = '\\ctext.character.musictext\\q\\f_\\ = ' & bpm;
if (text != '')
{
	marking = text & ' ' & marking;
}
tempo = score.SystemStaff.NthBar(bar).AddText(0, marking, 'text.system.tempo');
if (tempo = null)
{
	return Failure('Sibelius could not add the tempo marking.');
}
return CreateDictionary('bpm', bpm, 'measure', bar);}"
	AppendBars "(count) {
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
score.AddBars(count);
return CreateDictionary('count', count, 'total_measures', score.SystemStaff.BarCount);}"
	Transpose "(startBar, endBar, topStaff, bottomStaff, degree, intervalType) {
// Select the passage and transpose it by a 0-based degree (negative is
// down) and interval type, without double accidentals and leaving key
// signatures as they are.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, startBar, topStaff);
if (problem = '')
{
	problem = CheckPosition(score, endBar, bottomStaff);
}
if (problem != '')
{
	return Failure(problem);
}
selection = score.Selection;
selection.SelectPassage(startBar, endBar, topStaff + 1, bottomStaff + 1);
notes = 0;
for each NoteRest noteRest in selection
{
	notes = notes + noteRest.NoteCount;
}
selection.Transpose(degree, intervalType, False, False);
return CreateDictionary('notes', notes);}"
	SetArticulation "(startBar, endBar, staff, offsetNum, offsetDen, articulation, present) {
// Turn an articulation on (present True) or off on every note and chord
// of the passage, or on those starting offsetNum/offsetDen beats into each
// bar (a negative offsetNum means every note).
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPassage(score, startBar, endBar, staff);
if (problem != '')
{
	return Failure(problem);
}
notes = 0;
bar = startBar;
while (bar <= endBar)
{
	position = OffsetPosition(score, bar, offsetNum, offsetDen);
	for each NoteRest noteRest in StaffBar(score, bar, staff)
	{
		if ((noteRest.NoteCount > 0) and ((position < 0) or NearPosition(noteRest.Position, position)))
		{
			noteRest.SetArticulation(articulation, present);
			notes = notes + 1;
		}
	}
	bar = bar + 1;
}
return CreateDictionary('notes', notes);}"
	SetNotehead "(startBar, endBar, staff, offsetNum, offsetDen, noteStyle) {
// Give every note of the passage, or of the chords starting offsetNum/
// offsetDen beats into each bar (every chord when offsetNum is negative),
// the notehead style with index noteStyle.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPassage(score, startBar, endBar, staff);
if (problem != '')
{
	return Failure(problem);
}
notes = 0;
bar = startBar;
while (bar <= endBar)
{
	position = OffsetPosition(score, bar, offsetNum, offsetDen);
	for each NoteRest noteRest in StaffBar(score, bar, staff)
	{
		if ((position < 0) or NearPosition(noteRest.Position, position))
		{
			for each note in noteRest
			{
				note.NoteStyle = noteStyle;
				notes = notes + 1;
			}
		}
	}
	bar = bar + 1;
}
return CreateDictionary('notes', notes);}"
	AddLine "(startBar, endBar, staff, startNum, startDen, endNum, endDen, styleId) {
// A line of style styleId from startNum/startDen beats into startBar (its
// start when startNum is negative) to endNum/endDen beats into endBar (its
// end when endNum is negative).
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPassage(score, startBar, endBar, staff);
if ((problem = '') and (startNum >= 0))
{
	problem = CheckOffset(score, startBar, staff, startNum, startDen);
}
if (problem != '')
{
	return Failure(problem);
}
startPosition = 0;
if (startNum >= 0)
{
	startPosition = OffsetPosition(score, startBar, startNum, startDen);
}
endPosition = StaffBar(score, endBar, staff).Length;
if (endNum >= 0)
{
	endPosition = OffsetPosition(score, endBar, endNum, endDen);
	if (endPosition > StaffBar(score, endBar, staff).Length)
	{
		return Failure('That position is past the end of measure ' & endBar);
	}
}
duration = endPosition - startPosition;
bar = startBar;
while (bar < endBar)
{
	duration = duration + StaffBar(score, bar, staff).Length;
	bar = bar + 1;
}
if (duration <= 0)
{
	return Failure('The line would end before it starts.');
}
line = StaffBar(score, startBar, staff).AddLine(startPosition, duration, styleId);
if (line = null)
{
	return Failure('Sibelius could not add the line ' & styleId & '.');
}
return CreateDictionary('start_measure', startBar, 'end_measure', endBar, 'staff', staff);}"
	AddStaffText "(bar, staff, position, text, styleId) {
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
added = StaffBar(score, bar, staff).AddText(position, text, styleId);
if (added = null)
{
	return Failure('Sibelius could not add the text.');
}
return CreateDictionary('measure', bar, 'staff', staff);}"
	SetClef "(bar, staff, position, clefId) {
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
clef = StaffBar(score, bar, staff).AddClef(position, clefId);
if (clef = null)
{
	return Failure('Sibelius could not add the clef ' & clefId & '.');
}
return CreateDictionary('measure', bar, 'staff', staff);}"
	BeatToPosition "(bar, staff, offsetNum, offsetDen) {
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem = '')
{
	problem = CheckOffset(score, bar, staff, offsetNum, offsetDen);
}
if (problem != '')
{
	return Failure(problem);
}
return CreateDictionary('measure', bar, 'staff', staff, 'position', OffsetPosition(score, bar, offsetNum, offsetDen));}"
	AddRest "(bar, staff, position, duration) {
// ManuScript cannot add a rest directly: add a note and delete it, which
// leaves a rest of the same duration.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
barObject = StaffBar(score, bar, staff);
if ((position + duration) > barObject.Length)
{
	return Failure('The rest does not fit in what is left of measure ' & bar & '.');
}
note = barObject.AddNote(position, 60, duration);
if (note = null)
{
	return Failure('Sibelius could not add the rest to measure ' & bar & '.');
}
note.ParentNoteRest.Delete();
return NextPosition(barObject, bar, staff, position + duration);}"
	AddTuplet "(bar, staff, position, pitches, actual, normal, unit) {
// actual notes of length unit in the time of normal; a negative pitch is
// a rest.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
barObject = StaffBar(score, bar, staff);
played = normal * unit;
if ((position + played) > barObject.Length)
{
	return Failure('The tuplet does not fit in what is left of measure ' & bar & '.');
}
tuplet = barObject.AddTuplet(position, 1, actual, normal, unit);
if (tuplet = null)
{
	return Failure('Sibelius could not add a ' & actual & ':' & normal & ' tuplet.');
}
notes = 0;
for index = 0 to pitches.Length
{
	pitch = pitches[index];
	if (pitch < 0)
	{
		note = tuplet.AddNote(index * unit, 60, unit);
		if (note != null)
		{
			note.ParentNoteRest.Delete();
		}
	}
	else
	{
		note = tuplet.AddNote(index * unit, pitch, unit);
	}
	if (note = null)
	{
		return Failure('Sibelius could not add note ' & (index + 1) & ' of the tuplet.');
	}
	notes = notes + 1;
}
following = NextPosition(barObject, bar, staff, position + played);
following['notes'] = notes;
return following;}"
	SetTremolo "(startBar, endBar, staff, offsetNum, offsetDen, betweenNotes, strokes) {
// Tremolo strokes on the stem (betweenNotes False; -1 is a buzz roll) or
// between each note and the next (betweenNotes True), on every note and chord
// of the passage or on those starting offsetNum/offsetDen beats into each
// bar (every one when offsetNum is negative).
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPassage(score, startBar, endBar, staff);
if (problem != '')
{
	return Failure(problem);
}
notes = 0;
bar = startBar;
while (bar <= endBar)
{
	position = OffsetPosition(score, bar, offsetNum, offsetDen);
	for each NoteRest noteRest in StaffBar(score, bar, staff)
	{
		if ((noteRest.NoteCount > 0) and ((position < 0) or NearPosition(noteRest.Position, position)))
		{
			if (betweenNotes)
			{
				noteRest.DoubleTremolos = strokes;
			}
			else
			{
				noteRest.SingleTremolos = strokes;
			}
			notes = notes + 1;
		}
	}
	bar = bar + 1;
}
return CreateDictionary('notes', notes);}"
	AddGraceNotes "(bar, staff, position, count, slashed, duration) {
// count grace notes of duration before the note at position, on its
// lowest note's line, slashed (acciaccaturas) or not (appoggiaturas).
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
noteRest = NoteRestAt(StaffBar(score, bar, staff), position);
if (noteRest = null)
{
	return Failure('There is no note at that position of measure ' & bar & ' to add grace notes to.');
}
pitch = noteRest.Lowest.Pitch;
diatonicPitch = noteRest.Lowest.DiatonicPitch;
added = 0;
while (added < count)
{
	if (slashed)
	{
		grace = noteRest.AddAcciaccaturaBefore(pitch, duration, False, 1, diatonicPitch);
	}
	else
	{
		grace = noteRest.AddAppoggiaturaBefore(pitch, duration, False, 1, diatonicPitch);
	}
	if (grace = null)
	{
		return Failure('Sibelius could not add the grace notes.');
	}
	added = added + 1;
}
return CreateDictionary('measure', bar, 'staff', staff, 'notes', added);}"
	AddSticking "(bar, staff, position, letters) {
// One letter as a lyric under each voice 1 note or chord from position on,
// continuing into the following bars until the letters run out. The notes
// are collected first: ManuScript forbids adding to a bar while
// iterating over it.
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
bars = CreateSparseArray();
positions = CreateSparseArray();
durations = CreateSparseArray();
current = bar;
start = position;
while ((current <= score.SystemStaff.BarCount) and (bars.Length < letters.Length))
{
	for each NoteRest noteRest in StaffBar(score, current, staff)
	{
		if ((noteRest.VoiceNumber = 1) and (noteRest.NoteCount > 0) and ((noteRest.Position + 2) >= start) and (bars.Length < letters.Length))
		{
			bars.Push(current);
			positions.Push(noteRest.Position);
			durations.Push(noteRest.Duration);
		}
	}
	current = current + 1;
	start = 0;
}
for index = 0 to bars.Length
{
	lyric = StaffBar(score, bars[index], staff).AddLyric(positions[index], durations[index], letters[index]);
	if (lyric = null)
	{
		return Failure('Sibelius could not write the sticking.');
	}
}
return CreateDictionary('measure', bar, 'staff', staff, 'notes', bars.Length);}"
	PassageFailure "(index, problem) {
return Failure('Event ' & (index + 1) & ': ' & problem & '. The events before it were written.');}"
	MarkNoteRest "(noteRest, event) {
// Add a passage event's other chord notes and its markings to the note or
// chord just written.
pitches = event['pitches'];
for chordIndex = 1 to pitches.Length
{
	noteRest.AddNote(pitches[chordIndex]);
}
if (event['notehead'] >= 0)
{
	for each note in noteRest
	{
		note.NoteStyle = event['notehead'];
	}
}
articulations = event['articulations'];
for articulationIndex = 0 to articulations.Length
{
	noteRest.SetArticulation(articulations[articulationIndex], True);
}
if (event['single_tremolo'] > -2)
{
	noteRest.SingleTremolos = event['single_tremolo'];
}
if (event['double_tremolo'] >= 0)
{
	noteRest.DoubleTremolos = event['double_tremolo'];
}
lowest = noteRest.Lowest;
graces = 0;
while (graces < event['grace_count'])
{
	if (event['grace_slashed'])
	{
		noteRest.AddAcciaccaturaBefore(lowest.Pitch, event['grace_duration'], False, 1, lowest.DiatonicPitch);
	}
	else
	{
		noteRest.AddAppoggiaturaBefore(lowest.Pitch, event['grace_duration'], False, 1, lowest.DiatonicPitch);
	}
	graces = graces + 1;
}
return True;}"
	WritePassage "(bar, staff, position, events) {
// Write events (notes, chords and rests with their markings) one after the
// other from position in bar, moving into the next bar when one fills.
// Each event is a Dictionary that SibeliusBridge.write_passage builds:
// bar (0 to stay), offset_num/offset_den (offset_num -1 to stay), pitches
// (empty for a rest), duration, tuplet_actual/tuplet_normal/tuplet_index
// (index -1 outside a tuplet), notehead (-1 to keep), articulations,
// single_tremolo (-2 for none, -1 buzz), double_tremolo (-1 for none),
// grace_count, grace_slashed, grace_duration, sticking and dynamic ('' for
// none).
if (Sibelius.ScoreCount = 0)
{
	return Failure(_msgNoScore);
}
score = Sibelius.ActiveScore;
problem = CheckPosition(score, bar, staff);
if (problem != '')
{
	return Failure(problem);
}
notes = 0;
tuplet = null;
tupletStart = 0;
for index = 0 to events.Length
{
	event = events[index];
	tupletIndex = event['tuplet_index'];
	if (tupletIndex < 1)
	{
		if (event['bar'] > 0)
		{
			bar = event['bar'];
			position = 0;
		}
		if (event['offset_num'] >= 0)
		{
			problem = CheckBar(score, bar);
			if (problem = '')
			{
				problem = CheckOffset(score, bar, staff, event['offset_num'], event['offset_den']);
			}
			if (problem != '')
			{
				return PassageFailure(index, problem);
			}
			position = OffsetPosition(score, bar, event['offset_num'], event['offset_den']);
		}
	}
	problem = CheckBar(score, bar);
	if (problem != '')
	{
		return PassageFailure(index, problem);
	}
	barObject = StaffBar(score, bar, staff);
	duration = event['duration'];
	pitches = event['pitches'];
	pitch = 60;
	if (pitches.Length > 0)
	{
		pitch = pitches[0];
	}
	if (tupletIndex < 0)
	{
		if ((position + duration) > barObject.Length)
		{
			return PassageFailure(index, 'it does not fit in what is left of measure ' & bar);
		}
		note = barObject.AddNote(position, pitch, duration);
	}
	else
	{
		if (tupletIndex = 0)
		{
			if ((position + (event['tuplet_normal'] * duration)) > barObject.Length)
			{
				return PassageFailure(index, 'the tuplet does not fit in what is left of measure ' & bar);
			}
			tuplet = barObject.AddTuplet(position, 1, event['tuplet_actual'], event['tuplet_normal'], duration);
			if (tuplet = null)
			{
				return PassageFailure(index, 'Sibelius could not add the tuplet');
			}
			tupletStart = position;
		}
		note = tuplet.AddNote(tupletIndex * duration, pitch, duration);
	}
	if (note = null)
	{
		return PassageFailure(index, 'Sibelius could not write it');
	}
	noteRest = note.ParentNoteRest;
	// Read these first: a rest's placeholder note is deleted below.
	eventPosition = noteRest.Position;
	eventLength = noteRest.Duration;
	if (pitches.Length = 0)
	{
		noteRest.Delete();
	}
	else
	{
		MarkNoteRest(noteRest, event);
		notes = notes + noteRest.NoteCount;
	}
	if (event['sticking'] != '')
	{
		barObject.AddLyric(eventPosition, eventLength, event['sticking']);
	}
	if (event['dynamic'] != '')
	{
		barObject.AddText(eventPosition, '\\ctext.character.musictext\\' & event['dynamic'], 'text.staff.expression');
	}
	if (tupletIndex < 0)
	{
		position = position + duration;
	}
	else
	{
		if (tupletIndex = (event['tuplet_actual'] - 1))
		{
			position = tupletStart + (event['tuplet_normal'] * duration);
		}
	}
	if (position >= barObject.Length)
	{
		bar = bar + 1;
		position = 0;
	}
}
return CreateDictionary('measure', bar, 'staff', staff, 'position', position, 'events', events.Length, 'notes', notes);}"
}
